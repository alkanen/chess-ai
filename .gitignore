# Local Claude Code configuration
.claude/

# Local configuration (see chess-ai.example.toml)
chess-ai.toml

# Games saved by the server, in the default games directory (./games, and only there)
/games/

# Games the server holds while they last, in the default directory (./ongoing-games, and only there)
/ongoing-games/

# Datasets built from PGN files, in the default data directory (./data, and only there)
/data/

# Training runs, in the default runs directory (./runs, and only there)
/runs/

# PGN files downloaded to work with, which are nobody else's business
/downloaded_games/

# Editor backup files
*~

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Frontend dependencies and build output
frontend/node_modules/
src/chess_ai/web/static/
